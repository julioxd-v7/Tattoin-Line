# ------------------------------------------------------------------
# Tattoin Line — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# Nunca envie este arquivo preenchido para o Git.
# ------------------------------------------------------------------

# URL pública do site (sem barra no final). Usada em links de e-mail,
# retorno do pagamento e URL do webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Slug do artista dono do site (tabela artists). O seed cria "caio-martins".
ARTIST_SLUG=caio-martins

# Mercado Pago — Suas integrações > Credenciais
# Use as credenciais DE TESTE até validar todo o fluxo.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# Assinatura secreta do webhook (Suas integrações > Webhooks > Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=
# "test" ou "production" — exibido no painel para evitar confusão
MERCADOPAGO_ENV=test

# E-mail transacional (Resend). Sem estas variáveis, o painel mostra
# "E-mail não configurado" e nenhuma mensagem é enviada.
RESEND_API_KEY=
EMAIL_FROM="Tattoin Line <agenda@seudominio.com.br>"
# E-mail que recebe avisos de novas solicitações e reconciliações
ADMIN_NOTIFY_EMAIL=

# WhatsApp Cloud API (opcional — etapa adicional). Requer templates aprovados pela Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_STATUS=

# Segredo que protege as rotas de cron (/api/cron/*). Gere com: openssl rand -hex 32
CRON_SECRET=
